package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

android_test {
    name: "CtsAccessibilityServiceTestCases",
    team: "trendy_team_framework_accessibility",
    defaults: ["cts_defaults"],
    static_libs: [
        "com_android_server_accessibility_flags_lib",
        "android.view.accessibility.flags-aconfig-java",
        "ctstestrunner-axt",
        "cts-install-lib",
        "cts-wm-util",
        "flag-junit",
        "hamcrest-library",
        "mockito-target-minus-junit4",
        "compatibility-device-util-axt",
        "platform-test-annotations",
        "CtsAccessibilityCommon",
        "CtsInputMethodServiceCommon",
        "CtsVirtualDeviceCommonLib",
        "sts-device-util",
        "com.android.window.flags.window-aconfig-java",
        "androidx.test.rules",
        "androidx.test.espresso.core",
        "com_android_systemui_flags_lib",
    ],
    libs: [
        "android.test.runner.stubs.test",
        "android.test.base.stubs.test",
    ],
    srcs: ["src/**/*.java"],
    // Tag this module as a cts test artifact
    test_suites: [
        "cts",
        "general-tests",
        "sts",
    ],
    sdk_version: "test_current",
    per_testcase_directory: true,
    data: [
        ":CtsInputMethod1",
        ":CtsAccessibilityMultipleServicesApp",
        ":CtsAccessibilityWidgetProvider",
        ":CtsAccessibilityProxyApp",
        ":CtsAccessibilityLargeServiceVolumeApp",
        ":CtsAccessibilityUpdateServiceAppV1",
        ":CtsAccessibilityUpdateServiceAppV2",
        ":CtsAccessibilityUpdateServiceAppV3",
    ],
    java_resources: [
        ":CVE-358092445-v1",
        ":CVE-358092445-v2",
    ],
}

java_library_static {
    name: "CtsAccessibilityServiceUtils",
    sdk_version: "test_current",
    static_libs: [
        "androidx.core_core",
        "compatibility-device-util-axt",
        "CtsAccessibilityCommon",
    ],
    srcs: ["src/**/utils/*.java"],
}

test_module_config {
    name: "CtsAccessibilityServiceTestCases_cts_accessibilitydisplayproxytest",
    base: "CtsAccessibilityServiceTestCases",
    test_suites: ["general-tests"],
    include_filters: ["android.accessibilityservice.cts.AccessibilityDisplayProxyTest"],
}
